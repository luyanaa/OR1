magic
tech OR1
<< metal1 >>
rect 0 56 5 60
rect 0 -1 5 2
<< nwell >>
rect -4 35 9 62
<< labels >>
rlabel metal1 s 0 56 5 60 5 VDD
port 1 nsew power input
rlabel metal1 s 0 -1 5 2 5 VSS
port 2 nsew ground input
<< properties >>
string FIXED_BBOX 0 0 5 60
string LEFclass CORE
string LEFsite unit
string LEFsymmetry X Y
string LEFview TRUE
<< end >>
