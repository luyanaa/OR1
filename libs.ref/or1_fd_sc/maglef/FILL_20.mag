magic
tech OR1
<< metal1 >>
rect 0 56 4 60
rect 0 -1 4 2
<< nwell >>
rect -4 35 8 62
<< labels >>
rlabel metal1 s 0 56 4 60 4 VDD
port 1 nsew power input
rlabel metal1 s 0 -1 4 2 4 VSS
port 2 nsew ground input
<< properties >>
string FIXED_BBOX 0 0 4 60
string LEFclass CORE
string LEFsite unit
string LEFsymmetry X Y
string LEFview TRUE
<< end >>
