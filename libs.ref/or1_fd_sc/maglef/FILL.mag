magic
tech OR1
<< metal1 >>
rect 0 56 8 60
rect 0 -1 8 2
<< nwell >>
rect -3 35 11 62
<< labels >>
rlabel metal1 s 0 56 8 60 8 VDD
port 1 nsew power input
rlabel metal1 s 0 -1 8 2 8 VSS
port 2 nsew ground input
<< properties >>
string FIXED_BBOX 0 0 8 60
string LEFclass CORE
string LEFsite unit
string LEFsymmetry X Y
string LEFview TRUE
<< end >>
