
.subckt BUFX2 VDD A Y VSS
M0 VDD A a_2_6# VDD pfet w=4u l=0.4u
+ ad=0p pd=0u as=0p ps=0u 
M1 Y a_2_6# VDD VDD pfet w=8u l=0.4u
+ ad=0p pd=0u as=0p ps=0u 
M2 VSS A a_2_6# VSS nfet w=2u l=0.4u
+ ad=0p pd=0u as=0p ps=0u 
M3 Y a_2_6# VSS VSS nfet w=4u l=0.4u
+ ad=0p pd=0u as=0p ps=0u 
.ends BUFX2

.subckt DFFPOSX1 VDD VSS CLK D Q QB
