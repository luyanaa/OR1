/*
 * DFFRX2 = DFFRX1 core + static keeper (net104 -> net114, W=1.0/L=1.5 um).
 * DFFRX1 and DFFRX2 clk->Q tables were re-measured at 5 V (round 27); their
 * setup/hold tables are the inherited ones and are NOT characterised yet.
 * DFFPOSX1 is the rebuilt positive-edge cell (round 18): 30 transistors with
 * an inverter in front of the clock pin.  All six timing cells below are
 * re-characterised at 5 V.  DFFPOSX1 setup/hold are still the previous
 * table: they are NOT characterised yet.
*/
library(or1_fd_sc) {
  delay_model : table_lookup ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  current_unit : "1uA" ;
  capacitive_load_unit (1,pf) ;
  leakage_power_unit : "1nW" ;
  slew_upper_threshold_pct_rise : 80 ;
  slew_lower_threshold_pct_rise : 20 ;
  slew_upper_threshold_pct_fall : 80 ;
  slew_lower_threshold_pct_fall : 20 ;
  input_threshold_pct_rise : 49.0 ;
  input_threshold_pct_fall : 49.0 ;
  output_threshold_pct_rise : 50 ;
  output_threshold_pct_fall : 50 ;
  nom_voltage : 5 ;
  nom_temperature : 25 ;
  /* Library-wide design-rule defaults.  CTS (and resizer) read the library
     default_max_transition/default_max_capacitance for buffer slew/cap
     limits when a pin does not carry its own attribute; OR1 cells omit the
     per-pin attribute, so provide it here (matches the pin-level
     max_transition/max_capacitance values used elsewhere in this lib). */
  default_max_transition : 2.0 ;
  default_max_capacitance : 0.25 ;
  default_max_fanout : 16 ;
  lu_table_template(char_4x4) {
    variable_1 : input_net_transition ;
    variable_2 : total_output_net_capacitance ;
    index_1 ("0.2000, 0.5000, 1.0000, 2.0000") ;
    index_2 ("0.0100, 0.0300, 0.0600, 0.1200") ;
  }
  lu_table_template(constraint_1x1) {
    variable_1 : related_pin_transition ;
    index_1 ("0.1000") ;
  }
  lu_table_template(recovery_template_3x6) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("1000.0, 1001.0, 1002.0");
    index_2 ("1000.0, 1001.0, 1002.0, 1003.0, 1004.0, 1005.0");
  }


  lu_table_template(hold_template_3x5) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("1000.0, 1001.0, 1002.0");
    index_2 ("1000.0, 1001.0, 1002.0, 1003.0, 1004.0");
  }

  lu_table_template(setup_template_3x5) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("1000.0, 1001.0, 1002.0");
    index_2 ("1000.0, 1001.0, 1002.0, 1003.0, 1004.0");
  }

