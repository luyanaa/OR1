MACRO INVX1
  CLASS CORE ;
  SOURCE USER ;
  ORIGIN 0 0 ;
  SIZE 6.500 BY 30.000 ;
  SYMMETRY X Y ;
  SITE unit ;
  
    PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 1 14.5 3 16.5 ;
    END
  END A
    PIN VDD
    DIRECTION INPUT ;
    USE POWER ;
    PORT
      LAYER metal1 ;
        RECT -0.5 28.5 7 30.5 ;
    END
  END VDD
    PIN VSS
    DIRECTION INPUT ;
    USE GROUND ;
    PORT
      LAYER metal1 ;
        RECT -0.5 -0.5 7 1.5 ;
    END
  END VSS
    PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 4 10.3 6 12.3 ;
    END
  END Y
  OBS

    LAYER metal1 ;

      WIDTH 1.400 ;
      PATH 1.800 21.300 1.800 28.500 ;
      WIDTH 1.000 ;
      PATH 1.800 1.000 1.800 3.800 ;

      WIDTH 1.400 ;
      PATH 4.800 21.300 4.800 24.500 ;
      WIDTH 1.000 ;
      PATH 4.800 20.500 4.800 3.800 ;

    VIA 4.800 3.800  dcont ;
    VIA 4.800 24.500  dcont ;
    VIA 4.800 20.500  dcont ;
    VIA 4.800 22.500  dcont ;
    VIA 1.800 24.500  dcont ;
    VIA 1.800 3.800  dcont ;
    VIA 1.800 20.500  dcont ;
    VIA 1.800 22.500  dcont ;
    VIA 3.500 29.500  nsubcont ;
    VIA 2.000 15.500  pcont ;
    VIA 4.000 0.500  psubcont ;
  END
END INVX1

MACRO NAND2X1
  CLASS CORE ;
  SOURCE USER ;
  ORIGIN 0 0 ;
  SIZE 9.500 BY 30.000 ;
  SYMMETRY X Y ;
  SITE unit ;
 
    PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 1 14.5 3 16.5 ;
    END
  END A
    PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 4 8.5 6 10.5 ;
    END
  END B
    PIN VDD
    DIRECTION INPUT ;
    USE POWER ;
    PORT
      LAYER metal1 ;
        RECT -0.5 28.5 10 30.5 ;
    END
  END VDD
    PIN VSS
    DIRECTION INPUT ;
    USE GROUND ;
    PORT
      LAYER metal1 ;
        RECT -0.5 -0.5 10 1.5 ;
    END
  END VSS
    PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 7 13 9 15 ;
    END
  END Y
  OBS

    LAYER metal1 ;

      WIDTH 1.400 ;
      PATH 1.800 21.300 1.800 28.500 ;
      WIDTH 1.000 ;
      PATH 1.800 1.000 1.800 3.800 ;
      WIDTH 1.400 ;
      PATH 7.800 21.300 7.800 28.500 ;

      WIDTH 1.400 ;
      PATH 4.800 21.300 4.800 24.500 ;
      WIDTH 1.000 ;
      PATH 4.800 20.500 4.800 18.000 7.500 18.000 7.500 6.500 6.800 6.500 6.800 3.800 ;

    VIA 1.800 22.500  dcont ;
    VIA 1.800 20.500  dcont ;
    VIA 1.800 3.800  dcont ;
    VIA 1.800 24.500  dcont ;
    VIA 4.800 22.500  dcont ;
    VIA 4.800 20.500  dcont ;
    VIA 4.800 24.500  dcont ;
    VIA 6.800 3.800  dcont ;
    VIA 7.800 24.500  dcont ;
    VIA 7.800 22.500  dcont ;
    VIA 7.800 20.500  dcont ;
    VIA 5.500 29.500  nsubcont ;
    VIA 5.000 9.500  pcont ;
    VIA 2.000 15.500  pcont ;
    VIA 5.000 0.500  psubcont ;
  END
END NAND2X1

MACRO FILL
  CLASS  CORE ;
  FOREIGN FILL 0.000 0.000 ;
  ORIGIN 0.000 0.000 ;
  SIZE 1.600 BY 20.000 ;
  SYMMETRY X Y ;
  SITE core ;
    PIN gnd
    DIRECTION INPUT ;
    USE GROUND ;
    PORT
      LAYER metal1 ;
        RECT -0.4 -0.6 2 0.6 ;
    END
  END gnd
    PIN vdd
    DIRECTION INPUT ;
    USE POWER ;
    PORT
      LAYER metal1 ;
        RECT -0.4 19.4 2 20.6 ;
    END
  END vdd
END FILL

MACRO NOR2X1
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 9.5 BY 30 ;
  SYMMETRY X Y ;
  SITE unit ;
            PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 6 18 9 21 ;
    END
  END A
            PIN B
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 2 6 5 9 ;
    END
  END B
            PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 1 24 4 27 ;
    END
  END Y
            PIN VDD
    DIRECTION INPUT ;
    USE POWER ;
    PORT
      LAYER metal1 ;
        RECT -0.5 28.5 10 30.5 ;
    END
  END VDD
            PIN VSS
    DIRECTION INPUT ;
    USE GROUND ;
    PORT
      LAYER metal1 ;
        RECT -0.5 -0.5 10 1.5 ;
    END
  END VSS
END NOR2X1

MACRO TIEHI
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 1.6 BY 30 ;
  SYMMETRY X Y ;
  SITE unit ;
            PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT -1 14 2 17 ;
    END
  END Y
END TIEHI

MACRO TIELO
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 1.6 BY 30 ;
  SYMMETRY X Y ;
  SITE unit ;
            PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT -1 14 2 17 ;
    END
  END Y
END TIELO

MACRO dcont
  CLASS CORE ;
  OBS
    LAYER metal1 ;
      RECT -1.000 -1.000  1.000 1.000 ;
  END
END dcont

MACRO nsubcont
  CLASS CORE ;
  OBS
    LAYER metal1 ;
      RECT -1.000 -1.000  1.000 1.000 ;
  END
END nsubcont

MACRO pcont
  CLASS CORE ;
  OBS
    LAYER metal1 ;
      RECT -1.000 -1.000  1.000 1.000 ;
  END
END pcont

MACRO psubcont
  CLASS CORE ;
  OBS
    LAYER metal1 ;
      RECT -1.000 -1.000  1.000 1.000 ;
  END
END psubcont

END LIBRARY
