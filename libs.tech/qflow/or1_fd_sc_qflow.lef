    PORT
      LAYER metal2 ;
        RECT 3.3 9 5.3 11 ;
    END
  END CLK
    PIN D
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 11 9 13 11 ;
    END
  END D
    PIN Q
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal2 ;
        RECT 49.5 10.5 51.5 12.5 ;
    END
  END Q
    PIN VDD
