#=============================================================================
# Source: ported from the official OpenRule1um KLayout DRC deck
#   https://github.com/mineda-support/OpenRule1um  tech/tech/drc/drc.lydrc
#   (v1.51 by akita11 / seijiro.moriyama, v1.52 off-grid block by Chikau Takahashi)
# Batch-mode input/report handling and the OR1 layer comments were added here.
# License: Apache-2.0 (see OR1PDK/LICENSE and PROVENANCE.md); no rule value was
# relaxed relative to the upstream deck.
# OR1 (OpenRule1um) - KLayout DRC deck
#
# Ported from the official OpenRule1um KLayout DRC deck
#   MakeLSI_OpenRule1um/KLayout/OpenRule1um/tech/drc.lydrc  (rule v1.51)
# and cross-checked against the Glade deck
#   MakeLSI_OpenRule1um/Glade/OpenRule1um-drc.py            (rule v1.35)
#
# Invocation (librelane KLayout.DRC contract):
#   klayout -b -zz -r OR1.drc -rd input=<gds> -rd topcell=<cell> \
#           -rd report=<lyrdb> [-rd thr=N]
#=============================================================================
if $input
    _tc = nil
    _tc = $topcell if $topcell
    _tc = $top_cell if _tc.nil? && $top_cell
    if _tc
        source($input, _tc)
    else
        source($input)
    end
end
if $report
    report("OR1 DRC", $report)
else
    report("OR1 DRC")
end
## 1um Standard Rule DRC
# klayout drc rule v0.4: 2019/10/08: seijiro.moriyama@anagix.com
## ver1.00 : 2018/2/10:  akita11 akita@ifdl.jp
## ver1.01 : 2018/2/23:  akita11 akita@ifdl.jp (bug fix)
## ver1.10 : 2018/3/17:  akita11 akita@ifdl.jp (add rules based on rule v110)
## ver1.20 : 2018/4/13:  akita11 akita@ifdl.jp (add rules based on rule v120)
## ver1.30 : 2018/11/27: akita11 akita@ifdl.jp (add rules based for HPOL)
## ver1.31 : 2018/11/28: akita11 akita@ifdl.jp (modified HPOL gap rule)
## ver1.50 : 2021/09/27: akita11 akita@ifdl.jp (widemetal, gate-extension, NWL space)
## ver1.51 : 2021/09/30: akita11 akita@ifdl.jp (nom-MOS POL touching DIFF)
## ver1.52 : 2024/08/22 Chikau Takahashi (add OFF-GRIDS rules)
##           ported into OR1 with min_grid = 0.005 um, the grid the reference
##           layouts are actually drawn on (0.05 flags 806 items on PTC06-1,
##           0.02 -> 5448, 0.01 -> 796, 0.005 -> 0; PTC06-2 likewise 0)


nwl = input(1, 0)
nwl_dp = input(2, 0)
diff = input(3, 0) 
pol = input(5, 0)
hpol = input(6,0)
cnt = input(7, 0)
ml1 = input(8, 0)
via1 = input(9, 0) 
ml2 = input(10, 0)
via2 = input(11, 0)
ml3 = input(12, 0)
text = input(13, 0)
frame = input(14, 0)
res = input(15, 0)
cap = input(16, 0)
dio = input(17, 0)
parea = input(18, 0)
narea = input(19, 0)
pad = input(20, 0)
# DM_* are the contact/via "device/mask" layers.  The OpenRule1um library
# cells draw them explicitly; geometry created by the router/DEF flow does
# not, so derive the missing ones from the contact and cut layers.
_dm_dcn  = input(101, 0)
_dm_pcn  = input(102, 0)
_dm_nscn = input(103, 0)
_dm_pscn = input(104, 0)
_dm_via1 = input(105, 0)
_dm_via2 = input(106, 0)

# union without overlapping the drawn markers (the "overlap" rules check raw shapes)
dm_dcn  = _dm_dcn  | ((cnt & diff) - _dm_dcn)
dm_pcn  = _dm_pcn  | ((cnt & pol) - _dm_pcn)
dm_nscn = _dm_nscn | ((cnt & diff & narea & nwl) - _dm_nscn)
dm_pscn = _dm_pscn | ((cnt & diff & parea - nwl) - _dm_pscn)
dm_via1 = _dm_via1 | (via1 - _dm_via1)
dm_via2 = _dm_via2 | (via2 - _dm_via2)

ndiff = diff & narea
pdiff = diff & parea
nmos = ndiff & pol
pmos = pdiff & pol
mos = nmos | pmos
hipol = hpol & pol


# ---------------------------------------------------------------------------
# OFF-GRID rules (upstream DRC v1.52, min_grid = 0.05 um)
# ---------------------------------------------------------------------------
min_grid = 0.005.um
nwl.ongrid(min_grid).output("nwl off-grid", "nwl off grid")
diff.ongrid(min_grid).output("diff off-grid", "diff off grid")
pol.ongrid(min_grid).output("pol off-grid", "pol off grid")
hpol.ongrid(min_grid).output("hpol off-grid", "hpol off grid")
cnt.ongrid(min_grid).output("cnt off-grid", "cnt off grid")
ml1.ongrid(min_grid).output("ml1 off-grid", "ml1 off grid")
via1.ongrid(min_grid).output("via1 off-grid", "via1 off grid")
ml2.ongrid(min_grid).output("ml2 off-grid", "ml2 off grid")
via2.ongrid(min_grid).output("via2 off-grid", "via2 off grid")
ml3.ongrid(min_grid).output("ml3 off-grid", "ml3 off grid")
parea.ongrid(min_grid).output("Parea off-grid", "Parea off grid")
narea.ongrid(min_grid).output("Narea off-grid", "Narea off grid")
pad.ongrid(min_grid).output("PAD off-grid", "PAD off grid")


# ---------------------------------------------------------------------------
# Contact / marker rules from the rule table (libs.doc/doc/OpenRule1um.xlsx):
#   rule 28 : NWL - DM_pscn space 0.5
#   rule 44 : DM_dcn - Gate space 0.5
#   rule 53 : DM_pcn - POL space 0.5
#   rule 73 : VIA1 - CNT space 0.5
#   rule 23a: NWL encloses the n-substrate CONTACT by 1.0 (not the DM_nscn
#             annotation marker - the marker form reports 226 violations on
#             the PTC06-2 reference layout, the contact form reports 0 on both
#             reference chips and on every OR1 cell)
# ---------------------------------------------------------------------------
nsubcont = cnt & diff & narea & nwl
nwl.enclosing(nsubcont, 1.0).output("NWL-nsubcont enc < 1.0")
nwl.separation(dm_pscn.not_interacting(nwl), 0.5).output("NWL-DM_pscn space < 0.5")
dm_dcn.separation(mos.not_interacting(dm_dcn), 0.5).output("DM_dcn-Gate space < 0.5")
dm_pcn.separation(pol.not_interacting(dm_pcn), 0.5).output("DM_pcn-POL space < 0.5")
via1.separation(cnt.not_interacting(via1), 0.5).output("VIA1-CNT space < 0.5")

#puts 'Check GAP'
nwl.space(5.um).output("NWL space < 5.0")
parea.space(0.5.um).output("Parea space < 0.5")
narea.space(0.5.um).output("Narea space < 0.5")
parea.separation(narea.not_interacting(parea), 0.5.um).output("Parea-Narea space < 0.5")
diff.space(1.5.um).output("DIFF space < 1.5")
nwl.separation(ndiff.not_interacting(nwl), 3.um).output("NWL-Ndiff space < 3.0")
pdiff.separation(dm_nscn.not_interacting(pdiff), 0.5.um).output("Pdiff-NScont space < 0.5")
ndiff.separation(dm_pscn.not_interacting(ndiff), 1.0.um).output("Ndiff-PScont space < 1.0")
pol.space(1.0.um).output("POL space < 1.0")
mos.space(1.um).output(" POL(MOS) space < 1.0")
pol.separation(diff.not_interacting(pol), 0.5.um).output("POL-diff space < 0.5")
diff.separation(dm_dcn.not_interacting(diff), 1.um).output("Diff-dcont space < 1.0")
mos.separation(dm_dcn.not_interacting(mos), 0.5.um).output("MOS-dcont space < 0.5")
diff.separation(dm_pcn.not_interacting(diff), 1.0.um).output("Diff-pcont space < 1.5")
pol.separation(dm_pcn.not_interacting(pol), 0.5.um).output("POL-pcont space < 0.5, may be pseudo-error (can be ignored)")
ml1.space(1.um).output("ML1 space < 1.0")
ml2.space(1.um).output("ML2 space < 1.0")
ml3.space(1.um).output("ML3 space < 1.0")
ml1.separation(dm_dcn.not_interacting(ml1), 0.5.um).output("ML1-dcont space < 0.5, may be pseudo-error (can be ignored)")
ml1.separation(dm_pcn.not_interacting(ml1), 0.5.um).output("ML1-pcont space < 0.5, may be pseudo-error (can be ignored)")
dm_via1.space(0.5.um).output("via1 space < 0.5")
dm_via2.space(0.5.um).output("via2 space < 0.5")
ml1.separation(dm_via1.not_interacting(ml1), 0.5.um).output("ML1-via1 space < 0.5")
ml2.separation(dm_via1.not_interacting(ml2), 0.5.um).output("ML2-via1 space < 0.5")
ml2.separation(dm_via2.not_interacting(ml2), 0.5.um).output("ML2-via2 space < 0.5")
ml3.separation(dm_via2.not_interacting(ml3), 0.5.um).output("ML3-via2 space < 0.5")
dm_via1.separation(dm_dcn.not_interacting(dm_via1), 0.5.um).output("via1-dcont space < 0.5")
dm_via1.separation(dm_pcn.not_interacting(dm_via1), 0.5.um).output("via1-pcont space < 0.5")
dm_via1.separation(dm_nscn.not_interacting(dm_via1), 0.5.um).output("via1-nscont space < 0.5")
dm_via1.separation(dm_pscn.not_interacting(dm_via1), 0.5.um).output("via1-pscont space < 0.5")
dm_via1.separation(dm_via2.not_interacting(dm_via1), 0.5.um).output("via1-via2 space < 0.5")
dm_dcn.space(1.0.um).output("dcont space < 1.0")
hipol.space(2.0.um).output("Poly in HPOL space < 2.0")
pol.separation(hipol.not_interacting(pol), 1.0.um).output("Poly outside HPOL space < 1.0")
hpol.separation(mos, 3.0.um).output("HPOL MOS gate space < 3.0")

#puts 'Check Overlap'
dm_nscn.raw.merged(2).output("nsubcont overlap")
dm_dcn_mos = dm_dcn & mos
dm_dcn_mos.output("dcn-MOS overlap")

#puts 'Check Stacked Con/Via'
dm_pcn.and(dm_via1).not_in(dm_via1).output("pcont-via1 non-stack")
dm_dcn.and(dm_via1).not_in(dm_via1).output("dcont-via1 non-stack")
dm_via1.and(dm_via2).not_in(dm_via2).output("via1-via2 non-stack")

#puts 'Check Width'
nwl.width(4.um).output("NWL width < 4.0")
nwl_dp.width(4.um).output("NWL(diff.pot) width < 4.0")
parea.width(0.5.um).output("Parea width < 0.5")
narea.width(0.5.um).output("Narea width < 0.5")
diff.width(1.0.um).output("DIFF width < 1.0")
pol.width(1.um).output("POL width < 1.0")
ml1.width(1.um).output("ML1 width < 1.0")
ml2.width(1.um).output("ML2 width < 1.0")
ml3.width(1.um).output("ML3 width < 1.0")
hipol.width(2.0.um).output("Poly in HPOL width < 2.0")

### HIPOL length (22-82um)
polh = (pol.inside(hpol)) - dm_pcn
polh_e = polh.edges
polh_e_all = polh_e.with_length(2.1.um, 10000.um)
polh_e_ok = polh_e.with_length(22.um, 82.um)
(polh_e_all - polh_e_ok).output("POL in HPOL must be 22um - 82um")

#puts 'Check Enclose'
nwl.enclosing(pdiff, 2.um).output("Pdiff enclosure in NWL < 2.0")
dm_nscn.not_inside(nwl).output("nsubcon outside NWL")
parea.enclosing(diff, 0.5.um).output("DIFF enclosure in Parea < 0.5")
narea.enclosing(diff, 0.5.um).output("DIFF enclosure in Narea < 0.5")
hpol.enclosing(hipol, 5.0.um).output("POL enclosure in HPOL < 5.0")

#puts 'Check MOS gate extension'
pol.enclosing(diff, 1.um).output("POL gate extension < 1.0")

#puts 'Check stand-alone Cont/Via'
dmcnt1 = dm_dcn | dm_pcn
dmcnt2 = dmcnt1 | dm_nscn
dmcnt = dmcnt2 | dm_pscn
cnt.outside(dmcnt).output("Stand alone Cont")
via1.outside(dm_via1).output("Stand alone VIA1")
via2.outside(dm_via2).output("Stand alone VIA2")

#puts 'Check wide metal'
ml1w = ml1.sized(-7.4).sized(7.4)
dm_dcn_in_widemetal = dm_dcn.and(ml1w.interacting(dm_dcn))
ml1.enclosing(dm_dcn_in_widemetal, 0.5.um).output("DM_dcont encosure is less than 0.5 for wide M1 (>15um)")

dm_pcn_in_widemetal = dm_pcn.and(ml1w.interacting(dm_pcn))
ml1.enclosing(dm_pcn_in_widemetal, 0.5.um).output("DM_pcont encosure is less than 0.5 for wide M1 (>15um)")

dm_via1_in_widemetal = dm_via1.and(ml1w.interacting(dm_via1))
ml1.enclosing(dm_via1_in_widemetal, 0.5.um).output("DM_Via1 encosure is less than 0.5 for wide M1 (>15um)")

ml2w = ml2.sized(-7.4).sized(7.4)
dm_via1_in_widemetal = dm_via1.and(ml2w.interacting(dm_via1))
ml2.enclosing(dm_via1_in_widemetal, 0.5.um).output("DM_Via1 encosure is less than 0.5 for wide M2 (>15um)")

dm_via2_in_widemetal = dm_via2.and(ml2w.interacting(dm_via2))
ml2.enclosing(dm_via2_in_widemetal, 0.5.um).output("DM_Via2 encosure is less than 0.5 for wide M2 (>15um)")

ml3w = ml2.sized(-7.4).sized(7.4)
dm_via3_in_widemetal = dm_via2.and(ml3w.interacting(dm_via2))
ml3.enclosing(dm_via2_in_widemetal, 0.5.um).output("DM_Via2 encosure is less than 0.5 for wide M3 (>15um)")

# Checking non-MOS POL touching DIFF (DM_dcon)
pol_diff_edge = (dm_dcn.raw.edges & pol.edges)
pol_mos_edge  = (dm_dcn.raw.edges & mos.edges)
(pol_diff_edge - pol_mos_edge).output("DM_dcont touches non-MOS Poly")

