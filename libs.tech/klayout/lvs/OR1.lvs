#=============================================================================
# Source: original work for the OR1 PDK, following the extraction model of the
#   official OpenRule1um LVS deck (MakeLSI_OpenRule1um/Glade/OpenRule1um-lvs.py,
#   ver 0.91).  https://github.com/mineda-support/OpenRule1um
# License: Apache-2.0 (see OR1PDK/LICENSE and PROVENANCE.md).
# OR1 (OpenRule1um) - KLayout LVS deck
#
# Device extraction and netlist comparison for the 1 um single-poly 3-metal
# N-well CMOS process.  The extraction model follows the official
# OpenRule1um extraction deck
#   MakeLSI_OpenRule1um/Glade/OpenRule1um-lvs.py  (ver 0.91)
# and uses the layer set of the official KLayout DRC deck.
#
# Invocation:
#   klayout -b -zz -r OR1.lvs \
#           -rd input=<layout.gds> \
#           -rd schematic=<reference.cdl> \
#           -rd report=<out.lvsdb> \
#           -rd target_netlist=<out.spice> \
#           [-rd topcell=<cell>]
#
# Prints, as the last status line:
#   "INFO : Congratulations! Netlists match"
#   "ERROR : Netlists don't match"
#=============================================================================

# deep comparison: device-level netlists including W/L (upstream lvs.lylvs
# also runs in deep mode).  Without it the comparison is topology-only and a
# wrong device size still reports "Netlists match".
deep

if $input
    _tc = nil
    _tc = $topcell if $topcell
    _tc = $top_cell if _tc.nil? && $top_cell
    if _tc
        source($input, _tc)
    else
        source($input)
    end
end

if $report
    report_lvs($report)
else
    report_lvs
end

#-----------------------------------------------------------------------------
# Drawn layers
#-----------------------------------------------------------------------------
nwl   = input(1, 0)
diff  = input(3, 0)
pol   = input(5, 0)
cnt   = input(7, 0)
ml1   = input(8, 0)
via1  = input(9, 0)
ml2   = input(10, 0)
via2  = input(11, 0)
ml3   = input(12, 0)
parea = input(18, 0)
narea = input(19, 0)
res   = input(15, 0)   # poly / diffusion resistor marker (rule table: RES)
capm  = input(16, 0)   # MOS capacitor marker (CAP)
diom  = input(17, 0)   # diode marker (DIO)

dm_dcn  = input(101, 0)
dm_pcn  = input(102, 0)
dm_nscn = input(103, 0)
dm_pscn = input(104, 0)
dm_via1 = input(105, 0)
dm_via2 = input(106, 0)

# Contacts drawn by the router (no DM layer around them)
# Diffusion and poly contacts made by the router carry no DM marker, so they
# are derived.  Substrate/well taps CANNOT be derived (an n+ source/drain in
# an n-well is geometrically identical to an n-tap); the drawn DM_nscn /
# DM_pscn markers of the tap cells are authoritative.
dm_dcn  = dm_dcn  | (cnt & diff)
dm_pcn  = dm_pcn  | (cnt & pol)
dm_via1 = dm_via1 | via1
dm_via2 = dm_via2 | via2

#-----------------------------------------------------------------------------
# Derived device layers
#-----------------------------------------------------------------------------
bulk   = extent - nwl              # p substrate
ndif   = diff & narea              # n+ diffusion (source/drain, taps)
pdif   = diff & parea              # p+ diffusion (source/drain, taps)
# Conducting poly: the resistor body is NOT a conductor - it is turned into a
# resistor device below (the same rule the upstream fabrication deck uses for
# diffusion resistors: "diff_nores").
polc   = pol - res
# MOS channels: capacitor plates (CAP marker) and diode areas are not
# transistors
ngate  = ((ndif & polc) - nwl) - capm
pgate  = (((pdif & polc) & nwl) - capm) - diom
# Source/drain regions only: the diffusion polygon also covers the channel,
# which must NOT be attached to the terminals (that would short S to D).
sdn    = (((ndif - pol) - nwl) - res) - capm
sdp    = ((((pdif - pol) & nwl) - res) - capm) - diom

#-----------------------------------------------------------------------------
# Connectivity
#-----------------------------------------------------------------------------
connect(sdn,  cnt)
connect(sdp,  cnt)
connect(cnt,  ml1)
connect(polc, cnt)
connect(nwl,  dm_nscn)
connect(dm_nscn, ml1)
connect(bulk, dm_pscn)
connect(dm_pscn, ml1)
connect(ml1,  dm_via1)
connect(dm_via1, ml2)
connect(ml2,  dm_via2)
connect(dm_via2, ml3)

#-----------------------------------------------------------------------------
# Device extraction
#-----------------------------------------------------------------------------
extract_devices(mos4("pfet"),
    { "SD" => (sdp),
      "G"  => (pgate),
      "W"  => (pgate & nwl),
      "tS" => (sdp),
      "tD" => (sdp),
      "tG" => (polc),
      "tB" => (nwl) })

extract_devices(mos4("nfet"),
    { "SD" => (sdn),
      "G"  => (ngate),
      "W"  => (ngate & bulk),
      "tS" => (sdn),
      "tD" => (sdn),
      "tG" => (polc),
      "tB" => (bulk) })

#-----------------------------------------------------------------------------
# Passive device extraction
#
# Model: the resistor body is the drawn layer inside the RES marker, the
# contact heads are the terminal layer (same construction as the upstream
# fabrication deck, which uses nres.sized(0.5) inside "diff - nres" as the
# terminal layer).  The body is excluded from the conducting layer above, so
# the two heads become two different nets and the device is not shorted.
#-----------------------------------------------------------------------------
# Terminal layers are derived layers: they must be connected to the metal
# explicitly, otherwise the device terminals end up on isolated nets and the
# labeled layout nets stay floating (this is why the upstream deck has
# connect(rn_layer, diff_nores) after building rn_layer).
rterm_p  = cnt & pol & res
rterm_n  = cnt & diff & narea & res
rterm_pd = cnt & diff & parea & res
connect(rterm_p,  ml1)
connect(rterm_n,  ml1)
connect(rterm_pd, ml1)

rbody_p = (pol & res) - cnt
extract_devices(resistor("POLYRES", 20.0),
    { "R" => rbody_p, "C" => rterm_p, "tA" => rterm_p, "tB" => rterm_p })

rbody_n = ((diff & narea) & res) - cnt
extract_devices(resistor("NDIFFRES", 42.0),
    { "R" => rbody_n, "C" => rterm_n, "tA" => rterm_n, "tB" => rterm_n })

rbody_pd = ((diff & parea) & res) - cnt
extract_devices(resistor("PDIFFRES", 42.0),
    { "R" => rbody_pd, "C" => rterm_pd, "tA" => rterm_pd, "tB" => rterm_pd })

# p+ / n-well diode.
#
# KLayout's diode extractor builds the device where the P and N layers
# overlap; P forms the anode, N the cathode.  For a p+/n-well diode the anode
# is the p+ diffusion inside the well and the cathode is the well itself:
#
#     dio_p = pdif & nwl & diom      (the DIO marker scopes it to the device)
#     dio_n = nwl                     (the well is the cathode)
#
# Two connectivity requirements have to be met or extraction fails with
# "Terminal 'A' ... isn't connected":
#   * the anode diffusion is excluded from sdp (it must not become a MOS S/D),
#     so it needs its own contact rule: connect(dio_p, cnt);
#   * the n+ cathode is also the well tap, so the cell must draw a DM_nscn
#     marker over it (the PCell does) - otherwise the well and the cathode
#     metal stay on different nets.
dio_p = pdif & nwl & diom
dio_n = nwl
connect(dio_p, cnt)
extract_devices(diode("PDIO"), { "P" => dio_p, "N" => dio_n })

# MOS capacitor: poly plate over the diffusion plate inside the CAP marker.
capp1 = pol & capm
capp2 = diff & capm
connect(capp1, cnt)
connect(capp2, cnt)
extract_devices(capacitor("MOSCAP", 1.0e-15),
    { "P1" => capp1, "P2" => capp2 })

# KLayout's netlist comparer in this deck configuration verifies topology
# only: device parameters are not part of the compare even when
# enable_parameter()/tolerance() are set (verified with a negative control -
# a reference with W=5u instead of 6u still reports "Netlists match").
# W/L sign-off is therefore enforced by the netgen stage:
#   libs.tech/netgen/OR1_setup.tcl  keeps W/L (only ad/pd/as/ps are removed)
#   and a wrong W in the reference produces "property errors" (verified).
# The reference CDL itself matches the layouts exactly:
#   INVX1 6/2, BUFX2 3x6/3x2, NAND2X1 2x6/2x2, NOR2X1 2x6/2x2, DFFPOSX1 14x6/14x2.
ignore_parameter("pfet", "W")
ignore_parameter("pfet", "L")
ignore_parameter("nfet", "W")
ignore_parameter("nfet", "L")

# The passive devices are compared on presence and connectivity; their value
# is reported in the extracted netlist (a resistor's R follows from the drawn
# geometry, so it has to be checked against the user's own reference, e.g.
# with netgen).  Symmetric resistor terminals are equivalent.
["POLYRES", "NDIFFRES", "PDIFFRES", "PDIO", "MOSCAP"].each do |dev|
    ["R", "L", "W", "A", "P", "C", "AREA", "PERIM"].each do |par|
        begin
            ignore_parameter(dev, par)
        rescue
        end
    end
end

#-----------------------------------------------------------------------------
# Netlist clean-up and output
#-----------------------------------------------------------------------------
netlist.make_top_level_pins
# make_top_level_pins does not promote the labeled nets of device-only
# circuits (a resistor test cell ends up with 0 pins and no net names in the
# SPICE output), so promote every named top-level net explicitly.
begin
    netlist.each_circuit do |c|
        next unless c == netlist.top_circuit
        c.each_net do |n|
            next if n.name.nil? || n.name.empty?
            next if n.pin_count > 0
            begin
                p = c.create_pin(n.name)
                c.connect_pin(p.id, n)
            rescue
            end
        end
    end
rescue
end
# NOTE: netlist.purge / purge_nets / simplify / flatten_circuit are
# deliberately NOT called - in this KLayout version they empty the netlist
# (0 circuits) which makes compare() trivially succeed.
netlist.combine_devices

if $target_netlist
    writer = RBA::NetlistSpiceWriter::new
    writer.use_net_names = true
    target_netlist($target_netlist, writer, "OR1 LVS extracted netlist")
end

#-----------------------------------------------------------------------------
# Comparison
#-----------------------------------------------------------------------------
if $schematic
    schematic($schematic)

    # Flatten both sides to the top circuit so a hierarchical layout netlist
    # can be compared against the flat reference produced by flatten_ref.py.
    # NOTE: netlist.flatten_circuit was removed here.  With the flat netlists
    # produced by this deck it emptied the netlist (0 circuits), which made
    # compare() trivially succeed - a reference with a missing transistor
    # still reported "Netlists match".  Extraction is already flat, so no
    # flattening is needed.

    align
    schematic.combine_devices
    netlist.combine_devices

    # symmetric source/drain terminals
    ["pfet", "nfet"].each do |dev|
        begin
            equivalent_pins(dev, "S", "D")
        rescue
        end
    end

    # symmetric resistor terminals
    ["POLYRES", "NDIFFRES", "PDIFFRES"].each do |dev|
        begin
            equivalent_pins(dev, "A", "B")
        rescue
        end
    end

    ok = compare
    if ok
        puts("INFO : Congratulations! Netlists match")
    else
        puts("ERROR : Netlists don't match")
    end
else
    puts("INFO : Extracted netlist written to #{$target_netlist}")
end
